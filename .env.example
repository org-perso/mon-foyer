# Copier ce fichier en `.env` à la racine du dépôt : cp .env.example .env
# Ne jamais committer le fichier .env. Aucune valeur ci-dessous n'est un vrai secret.

# --- PostgreSQL (Docker Compose) ---
POSTGRES_USER=monfoyer
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=monfoyer
POSTGRES_PORT=5432

# --- API NestJS ---
NODE_ENV=development
API_PORT=3001
DATABASE_URL=postgresql://monfoyer:change-me-local-only@localhost:5432/monfoyer?schema=public
# Origine du frontend : CORS + vérification de l'émetteur des jetons Clerk (authorizedParties)
WEB_ORIGIN=http://localhost:3000

# --- Authentification (Clerk) — https://dashboard.clerk.com → Configure → API keys ---
# Clé publique : utilisée par le frontend ET l'API
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
# Clé secrète : serveur uniquement (Next.js côté serveur + API)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
# Webhook (Configure → Webhooks) : endpoint <URL publique de l'API>/api/webhooks/clerk
# Événements : user.created, user.updated, user.deleted
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
# Routes des pages d'authentification
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- Images (Cloudinary) — https://console.cloudinary.com → Settings → API Keys ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxx
# Dossier racine des images (séparer dev / prod)
CLOUDINARY_FOLDER=mon-foyer-dev

# --- Règles métier ---
DEFAULT_CURRENCY=MGA
APP_TIMEZONE=Indian/Antananarivo
INVITATION_TTL_HOURS=72

# --- Frontend Next.js ---
# URL de l'API utilisée côté serveur Next.js (proxy /api/*)
API_INTERNAL_URL=http://localhost:3001
