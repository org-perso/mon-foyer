# Copier ce fichier en `.env` à la racine du dépôt : cp .env.example .env
# Ne jamais committer le fichier .env. Aucune valeur ci-dessous n'est un vrai secret.

# --- PostgreSQL (Docker Compose) ---
POSTGRES_USER=monfoyer
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=monfoyer
POSTGRES_PORT=5432

# --- API NestJS ---
NODE_ENV=development
API_PORT=3001
DATABASE_URL=postgresql://monfoyer:change-me-local-only@localhost:5432/monfoyer?schema=public
# Origine du frontend autorisée (CORS + cookies d'authentification)
WEB_ORIGIN=http://localhost:3000

# --- Authentification (Better Auth) ---
# Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-32-bytes-secret
# URL publique où les routes /api/auth/* sont servies (via le proxy Next.js)
BETTER_AUTH_URL=http://localhost:3000

# --- Règles métier ---
DEFAULT_CURRENCY=MGA
APP_TIMEZONE=Indian/Antananarivo
INVITATION_TTL_HOURS=72

# --- Frontend Next.js ---
# URL de l'API utilisée côté serveur Next.js (proxy /api/*)
API_INTERNAL_URL=http://localhost:3001
